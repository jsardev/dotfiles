{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": ["@mohak34/opencode-notifier@latest"],
  "provider": {
    "openrouter": {
      "models": {
        "moonshotai/kimi-k2.6": {
          "name": "Kimi K2.6 (Fast)",
          "options": {
            "provider": {
              "sort": "throughput",
            },
          },
        },
      },
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:MCP_CONTEXT7_API_KEY}",
      },
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/{env:FIRECRAWL_API_KEY}/v2/mcp",
    },
    "instantdomainsearch": {
      "type": "remote",
      "url": "https://api.instantdomainsearch.com/mcp/streamable-http",
    },
  },
}
