{
	"agent_servers": {
		"opencode": {
			"type": "registry",
			"default_model": "zai-coding-plan/glm-4.7-flash",
			"favorite_models": [
				"zai-coding-plan/glm-4.7",
				"zai-coding-plan/glm-4.7-flash",
				"openrouter/minimax/minimax-m2.1",
				"openrouter/x-ai/grok-code-fast-1",
				"openrouter/moonshotai/kimi-k2.5"
			]
		}
	},
	"ssh_connections": [
		{
			"host": "nas",
			"args": [],
			"projects": [{ "paths": ["/volume1/docker"] }]
		}
	],
	"indent_guides": {
		"background_coloring": "disabled",
		"coloring": "indent_aware"
	},
	"colorize_brackets": true,
	"base_keymap": "JetBrains",
	"buffer_font_family": "JetBrains Mono",
	"buffer_font_size": 14,
	"code_actions_on_format": {
		"source.fixAll.biome": true
	},
	"edit_predictions": {
		"mode": "eager",
		"provider": "mercury"
	},
	"ensure_final_newline_on_save": false,
	"format_on_save": "off",
	"git_panel": {
		"dock": "right"
	},
	"icon_theme": "Zed (Default)",
	"inlay_hints": {
		"enabled": false,
		"toggle_on_modifiers_press": {
			"control": true
		}
	},
	"languages": {
		"JavaScript": {
			"language_servers": ["biome", "tailwindcss-language-server", "vtsls"],
			"formatter": "language_server"
		},
		"TypeScript": {
			"language_servers": ["biome", "tailwindcss-language-server", "vtsls"],
			"formatter": "language_server"
		},
		"TSX": {
			"language_servers": ["biome", "tailwindcss-language-server", "vtsls"],
			"formatter": "language_server"
		},
		"CSS": {
			"language_servers": ["biome", "tailwindcss-language-server"],
			"formatter": "language_server"
		},
		"JSON": {
			"language_servers": ["biome", "vtsls"],
			"formatter": "language_server"
		},
		"JSONC": {
			"language_servers": ["biome", "vtsls"],
			"formatter": "language_server"
		},
		"SQL": {
			"formatter": {
				"external": {
					"command": "sql-formatter",
					"arguments": ["--language", "postgresql"]
				}
			}
		}
	},
	"lsp": {
		"tailwindcss-language-server": {
			"settings": {
				"classFunctions": ["cva", "cx"],
				"experimental": {
					"classRegex": ["[cls|className]\\s\\:\\=\\s\"([^\"]*)"]
				}
			}
		}
	},
	"lsp_document_colors": "inlay",
	"project_panel": {
		"auto_fold_dirs": false
	},
	"tab_size": 2,
	"theme": "Zedokai Darker (Filter Spectrum)",
	"ui_font_family": "JetBrains Mono",
	"ui_font_size": 14
}
