font-family = JetBrains Mono
font-size = 14

theme = Monokai Pro Spectrum
# theme = /Users/jsarnowski/.dotfiles/src/ghostty/theme

shell-integration-features = ssh-env

keybind = global:opt+space=toggle_visibility

keybind = cmd+]=next_tab
keybind = cmd+[=previous_tab

keybind = cmd+shift+]=move_tab:+1
keybind = cmd+shift+[=move_tab:-1

keybind = cmd+shift+h=new_split:right
keybind = cmd+shift+v=new_split:down
keybind = cmd+up=goto_split:top
keybind = cmd+down=goto_split:bottom
keybind = cmd+left=goto_split:left
keybind = cmd+right=goto_split:right

# https://github.com/sst/opencode/issues/1505
keybind = shift+enter=text:\x1b[13;2u